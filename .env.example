VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
VITE_CLOUDINARY_CLOUD_NAME=seu-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=seu-upload-preset-unsigned
# Para onde vai quem escolhe pagar a assinatura no Pix (web#447). Só dígitos,
# com país e DDD — máscara também serve, os não-dígitos são descartados. Sem ele
# a tela mostra o preço do Pix e esconde o atalho — botão que abre o WhatsApp sem
# destino faz a pessoa achar que mandou mensagem.
#
# Qualquer coisa com menos de 12 dígitos é tratada como ausente (web#463): o
# atalho some, em vez de virar um link para lugar nenhum.
#
# Ao configurar na Vercel, use `--no-sensitive`. Variável de Production nasce
# sensitive, e nesse estado o `vercel pull` do CI devolve o literal
# `[SENSITIVE]`, que o Vite inlina no bundle.
VITE_WHATSAPP_ASSINATURA=5535999999999

# Para onde vão os erros que acontecem no navegador de quem usa (web#529).
# sentry.io → projeto React → DSN. VAZIO desliga: o app funciona igual e o
# erro fica só no console, que é o que já acontecia antes.
#
# O SDK entra por `import()`, em chunk próprio: estático, ele engordaria a
# primeira tela em 86 KiB para todo visitante. Ver src/config/observabilidade.ts.
VITE_SENTRY_DSN=
