{
  "name": "so-mais-um-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=.vitest-report.json",
    "readme:check": "node scripts/verifica-numeros-do-readme.mjs",
    "readme:fix": "node scripts/verifica-numeros-do-readme.mjs --fix",
    "primeira-tela:check": "node scripts/verifica-primeira-tela.mjs",
    "formatacao:check": "node scripts/verifica-formatacao.mjs",
    "contrato:check": "node scripts/verifica-contrato-com-o-produto.mjs",
    "test:responsividade": "playwright test -c e2e/responsividade/playwright.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-oauth/google": "^0.13.5",
    "@sentry/react": "^10.75.1",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.20.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.7",
    "styled-components": "^6.4.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "5.7",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@5": "^5.0.12",
    "browserslist": "^4.29.0",
    "baseline-browser-mapping": "^2.11.25",
    "form-data": "^4.0.6",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.28",
    "@babel/core": "^7.29.7"
  }
}
