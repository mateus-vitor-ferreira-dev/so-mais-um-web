{
  "name": "so-mais-um-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=.vitest-report.json",
    "readme:check": "node scripts/verifica-numeros-do-readme.mjs",
    "readme:fix": "node scripts/verifica-numeros-do-readme.mjs --fix",
    "primeira-tela:check": "node scripts/verifica-primeira-tela.mjs",
    "formatacao:check": "node scripts/verifica-formatacao.mjs",
    "contrato:check": "node scripts/verifica-contrato-com-o-produto.mjs",
    "test:responsividade": "playwright test -c e2e/responsividade/playwright.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.20.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "styled-components": "^6.5.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "5.7",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@5": "^5.0.12",
    "browserslist": "^4.29.0",
    "baseline-browser-mapping": "^2.11.25",
    "form-data": "^4.0.6",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.28",
    "@babel/core": "^7.29.7"
  }
}
